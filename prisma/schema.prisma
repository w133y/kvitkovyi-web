generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // DATABASE_URL is Neon's pooled (PgBouncer, "-pooler" host) connection —
  // right for the app's own runtime queries (serverless, many short-lived
  // connections), but `prisma migrate deploy` needs a direct connection for
  // its advisory locking. Without directUrl, migrate deploy used the pooled
  // one too and failed with P1002 (timeout) during the Vercel build.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A rolling log of server-side errors (failed Discord/Kinetic/Cloudinary/
// Donatello/mc-db calls, mostly) shown on /admin — see lib/admin-log.ts.
// Vercel's own function logs already have all of this, but they're not
// something the admin can casually check from the site itself. Pruned back
// to the newest ADMIN_LOG_MAX_ENTRIES rows opportunistically whenever the
// admin panel loads (see listAdminLogs), not on every write.
model AdminLogEntry {
  id        String   @id @default(cuid())
  message   String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Singleton (id always "default") — whether logError() persists to
// AdminLogEntry at all. Off doesn't touch the console.error() every call
// site still does alongside it, only the DB write + /admin visibility.
model AdminSettings {
  id                  String  @id @default("default")
  errorLoggingEnabled Boolean @default(true)
}

// --- Auth.js (NextAuth) required models ---
// https://authjs.dev/getting-started/adapters/prisma

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Denormalized from the Discord Account for convenient joins against the
  // Minecraft server's DB (see lib/mc-db.ts) without re-querying Account.
  discordId String? @unique
  role      Role    @default(USER)

  // Opt-in: shows this account's Discord name/avatar (name/image above,
  // populated by the adapter from the Discord OAuth profile) on the public
  // /profile/[nickname] page. Off by default — most players never chose to
  // publish their Discord identity, so a default of "visible" would leak it.
  showDiscord Boolean @default(false)
  // Freeform links, shown as icons on the public profile when set (no
  // separate on/off toggle — an empty value just doesn't render an icon).
  twitchUrl  String?
  youtubeUrl String?

  // "he" | "she" | "they" | null. Never rendered as its own label on the
  // profile page — it only picks the grammatical gender of Ukrainian
  // past-tense text that refers to this player (e.g. "Заходив"/"Заходила"/
  // "Заходили" for last-seen). null falls back to the masculine default,
  // same wording the site used before this field existed.
  pronoun String?

  accounts       Account[]
  sessions       Session[]
  orders         Order[]
  donateOrders   DonateOrder[]
  cosmeticOrders CosmeticOrder[]
  galleryPhotos  GalleryPhoto[]
  mapMarkers     MapMarker[]
  wikiArticles   WikiArticle[]
}

// Keyed by Minecraft nickname (not User) so it survives a Discord relink and
// stays keyed the same way the public /profile/[nickname] route is. Editable
// only by whoever's current Discord-linked nickname (via mc-db's
// getDiscordLink) matches — see lib/actions/bio.ts.
model PlayerBio {
  nickname  String   @id
  bio       String   @db.VarChar(160)
  updatedAt DateTime @updatedAt
}

// Admin-awarded badges shown on the public /profile/[nickname] page (season
// participation, hosting a project, top playtime, mayor of a town, event
// winner, sponsor, etc). Keyed by nickname like PlayerBio, for the same
// reason. No automation yet — every row is created by hand in /admin — but
// the shape already supports it: a later job could upsert rows for things
// like "most playtime" without changing this model.
model Achievement {
  id       String @id @default(cuid())
  nickname String

  // Badge label shown at the top of the card — a preset (Мер, Спонсор,
  // Івент, Старожил, Гравець) or free text, picked in the admin form.
  category String

  // "emoji" renders `icon` as text (e.g. "🏆"); "image" renders it as an
  // <img src>. Kept as a plain string rather than an enum so the admin form
  // doesn't need a migration to add a third kind later.
  iconType String @default("emoji")
  icon     String

  title    String // big text under the icon: city/event name, "1200 год.", etc.
  subtitle String? // optional smaller text under the title: season number, etc.

  // Raw CSS values chosen in the admin form (a hex color, or a full
  // gradient() string for background) — null means "use the card's default
  // look" rather than force every badge to pick a style.
  borderColor String?
  background  String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([nickname])
}

// Флорист/Меценат donate tiers (see /shop/sponsorship). Payment isn't
// wired up yet (Donatello polling worker is a later phase) — for now an
// admin grants/revokes these by hand from /admin, same as Achievement.
// A row past its expiresAt is simply inactive; nothing deletes it
// automatically, so it stays visible in the admin audit list.
enum DonateTier {
  FLORIST
  MECENAT
}

model DonatePrivilege {
  id       String     @id @default(cuid())
  nickname String
  tier     DonateTier

  // Custom icon — Меценат only. Флорист's icon is fixed (see
  // lib/minecraft-symbols.ts FLORIST_SYMBOL/FLORIST_COLOR_HEX), so those
  // rows leave these null rather than duplicating the same fixed values.
  iconSymbol   String?
  iconColorHex String?

  expiresAt DateTime
  createdAt DateTime @default(now())

  // Set once the in-game grant (LuckPerms group + prefix) has actually been
  // revoked — by the expiry sweep (see lib/donate-privilege-grants.ts) or by
  // an admin manually deleting the row. The row itself is never deleted on
  // expiry (kept for the admin audit list); a manual admin delete removes
  // the row outright, so this only ever gets set by the expiry sweep.
  revokedAt DateTime?

  // Set once the "expires tomorrow" Discord DM has gone out (see
  // lib/donate-privilege-reminders.ts) — guards against sending it twice if
  // the daily cron run overlaps its own lookback window, not a record of
  // delivery success (a DM that fails to send still marks this to avoid
  // retrying every run).
  reminderSentAt DateTime?

  // Set once the "your privilege has ended" DM has gone out (same
  // mark-even-on-failure semantics as reminderSentAt).
  expiredNoticeSentAt DateTime?

  @@index([nickname])
}

enum DonateOrderStatus {
  PENDING
  PAID
  // Never paid within ORDER_TIMEOUT_MS (10 min) of creation — set
  // opportunistically the next time the order is read or polled (same
  // no-cron tradeoff as the DonatePrivilege expiry sweep), not the instant
  // the deadline passes. See lib/actions/donate-order.ts's expireIfStale.
  EXPIRED
}

// A pending Флорист/Меценат purchase created when someone hits
// "Продовжити" on /shop/sponsorship — carries a random `code` the buyer is
// asked to put in their Donatello donation message so the poller (see
// lib/actions/donate-order.ts) can match the donation back to this exact
// order without a webhook. Paying grants a DonatePrivilege row, same as an
// admin's manual grant.
model DonateOrder {
  id     String @id @default(cuid())
  code   String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Who the privilege actually goes to — normally the buyer's own linked
  // nickname, but the builder lets them gift it to a different player, so
  // this can differ from buyerNickname below.
  nickname String
  // The buyer's own linked nickname, always — kept separately from
  // `nickname` so the Discord log (and any future "my purchases" view) can
  // show who actually paid even on a gifted order.
  buyerNickname String

  tier         DonateTier
  iconSymbol   String? // Меценат only, snapshotted at order creation
  iconColorHex String?
  // 1-6 — the discount schedule (5% at 5, 10% at 6) lives in
  // lib/actions/donate-order.ts, amountUah below is already the discounted
  // total for this many months, not a per-month price.
  months    Int @default(1)
  amountUah Int

  status DonateOrderStatus @default(PENDING)
  // The matched Donatello donation's pubId, once paid — @unique so the same
  // real-world donation can never be claimed by two orders.
  donatelloPubId String? @unique

  // The Discord message id of this order's status post in the admin log
  // channel (see lib/discord.ts) — set right after that message is sent, so
  // the payment confirmation can edit it in place instead of posting again.
  discordMessageId String?

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([userId])
  @@index([status])
}

// --- Gallery ---

enum GalleryPhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GalleryPhotoSource {
  SITE // submitted through the form under the homepage slider
  DISCORD // submitted via the /gallery slash command
  LEGACY // the original hardcoded ImageSlider images, migrated in once
}

model GalleryPhoto {
  id String @id @default(cuid())

  url        String // public R2 URL (or a Discord CDN attachment URL for DISCORD-sourced photos)
  storageKey String? // R2 object key, for deletion — null for LEGACY/DISCORD (never uploaded to R2)

  description     String?
  // Moderators can hide a description without deleting it (a "toggle
  // with/without" button in the moderation message) rather than it being
  // all-or-nothing.
  showDescription Boolean @default(true)
  // Shown bottom-right on hover, on the site only — LEGACY photos have none
  // by design (see lib/gallery-log.ts / the migration script).
  author          String?
  // Same "hide without deleting" idea as showDescription — separate flag so
  // a moderator can turn off just the author credit while keeping the
  // description shown, or vice versa.
  showAuthor      Boolean @default(true)
  season          Int

  source GalleryPhotoSource
  status GalleryPhotoStatus @default(PENDING)

  // Site submitter, for the 3-per-day rate limit — null for DISCORD/LEGACY.
  submittedByUserId String?
  submittedByUser   User?   @relation(fields: [submittedByUserId], references: [id])
  // Discord submitter — null for SITE/LEGACY. The slash-command route is
  // explicitly exempt from the rate limit, so this is for attribution only.
  submittedByDiscordId String?

  // The moderation message in DISCORD_GALLERY_CHANNEL_ID — edited in place
  // as its buttons are used (approve/reject/edit description/toggle
  // description), see app/api/discord/interactions/route.ts.
  discordMessageId String?

  createdAt  DateTime  @default(now())
  approvedAt DateTime?

  @@index([status])
  @@index([source, status, createdAt])
  @@index([season])
}

// Singleton (id is always "default") — the season new site submissions
// default to, changeable from /admin but only after a Yes/No confirmation
// posted to DISCORD_ADMIN_CONFIRM_CHANNEL_ID (see lib/actions/gallery.ts and
// the interactions route) actually applies it.
model GallerySettings {
  id            String  @id @default("default")
  currentSeason Int     @default(1)
  // When true, the site submission form's season field is locked to
  // currentSeason (shown read-only) — submitGalleryPhoto also enforces
  // this server-side, never trusting the client's season value while
  // locked. No Discord confirmation for this one, unlike currentSeason
  // itself — it's a simple on/off, not something that reshuffles data.
  seasonLocked  Boolean @default(false)

  pendingSeason          Int?
  pendingSeasonMessageId String?
  pendingSeasonAdminName String?
}

// --- Shop ---

enum ProductCategory {
  SPONSORSHIP
  COSMETIC
}

model Product {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String
  category    ProductCategory
  // Null for COSMETIC rows — those are priced in квітки on the linked
  // CosmeticItem.priceFlowers instead, a different unit entirely (not UAH
  // cents). SPONSORSHIP rows still use this via the generic /shop/cart +
  // /shop/checkout flow.
  priceCents  Int?
  currency    String          @default("UAH")
  imageUrl    String?
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  orderItems   OrderItem[]
  cosmeticItem CosmeticItem?

  // Matches getProductsByCategory's exact where + orderBy shape (every
  // /shop/cosmetics and /shop/sponsorship page load).
  @@index([category, active, sortOrder])
}

enum OrderStatus {
  PENDING
  FULFILLED
  CANCELLED
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  status     OrderStatus @default(PENDING)
  totalCents Int
  currency   String      @default("UAH")

  // Captured at checkout time — a Discord account may not always resolve to
  // a linked player later, so we snapshot what the buyer told us.
  minecraftNickname String?
  note              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([userId])
  // Matches getLeaderboardBadges' fulfilled-sponsorship-orders lookup, which
  // runs (at most once a minute, cached) on every /leaderboard visit.
  @@index([status])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity       Int @default(1)
  unitPriceCents Int // snapshot of Product.priceCents at purchase time

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// Косметика — 3D models (Nexo furniture, HMCCosmetics hats/backpacks/
// balloons) sold for квітки (in-game SimpleCurrency balance, see
// lib/mc-db.ts getFlowerBalance), not UAH. Product (above) is still the
// catalog row (name/active/sortOrder all fit); this holds the fields a
// sponsorship Product never needs — which live-server item this maps to,
// where its model/texture live in R2, and its price in flowers rather than
// priceCents. See lib/cosmetics/*.
enum CosmeticType {
  HAT
  BACKPACK
  BALLOON
  FURNITURE
}

enum CosmeticStatus {
  // Admin uploaded/auto-detected but hasn't confirmed name/type/price yet —
  // not pushed to the live server, not shown in the public catalog.
  DRAFT
  // Confirmed by the admin: files pushed to Nexo/HMCCosmetics, live in the
  // public catalog.
  PUBLISHED
}

model CosmeticItem {
  id        String         @id @default(cuid())
  productId String         @unique
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      CosmeticType
  status    CosmeticStatus @default(DRAFT)

  // The id this item is registered under in items.yml / hmccosmetics.yml on
  // the live server (see lib/cosmetics/nexo-pack.ts) — unique because it's
  // also the Nexo namespace key, which can't collide.
  nexoItemId String  @unique
  // Set for HAT/BACKPACK/BALLOON only — the id HMCCosmetics' own
  // cosmetics.yml keys the permission/dye config under (often == nexoItemId
  // but not guaranteed by the source packs, so tracked separately).
  hmcCosmeticId String?

  // HAT-only in v1 — HMCCosmetics dye-tints LEATHER_HORSE_ARMOR natively
  // in-game after unlock; the site never sends a color at grant time (see
  // lib/cosmetics/grant.ts). Furniture has no such native support (Nexo
  // items have no color field), so it ships without recolor for now.
  colorCustomizable Boolean @default(false)

  modelKey       String // R2 key — the block-model JSON
  textureKey     String // R2 key — the PNG
  thumbnailUrl   String? // baked preview, captured client-side from the same 3D viewer
  sourcePackName String? // which admin upload this came from (edit/lineage only)

  priceFlowers Int // NOT priceCents on Product — a flower count

  // The source pack's own Nexo `Mechanics:` (seats, hitboxes, doors…), read
  // at upload time by lib/cosmetics/nexo-pack.ts — used on first publish
  // instead of the generic one-barrier furniture default.
  sourceMechanics Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grants CosmeticGrant[]
}

enum CosmeticGrantStatus {
  PENDING
  DELIVERED
  FAILED
}

// One checkout, possibly several items — mirrors DonateOrder's role for the
// sponsorship flow, but settled in квітки via sendServerCommand("currency
// take ...") instead of a Donatello UAH payment.
model CosmeticOrder {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Snapshot, same reasoning as DonateOrder — the buyer's linked nickname
  // at checkout time.
  nickname     String
  totalFlowers Int

  // Client-generated once per checkout attempt (crypto.randomUUID(),
  // cleared only on success/failure) — a rapid double-click resubmits the
  // same key, which this unique constraint turns into a no-op instead of a
  // second charge. See lib/actions/cosmetics-checkout.ts.
  idempotencyKey String @unique

  createdAt DateTime @default(now())

  grants CosmeticGrant[]

  @@index([userId])
}

// Per-item delivery record and retry unit — a CosmeticOrder can charge
// квітки successfully while one item's in-game grant still fails (player
// offline, a transient Kinetic error), so delivery is tracked per item, not
// per order. See lib/cosmetics/sweep.ts, mirroring
// sweepExpiredDonatePrivileges' opportunistic-sweep pattern.
model CosmeticGrant {
  id             String              @id @default(cuid())
  orderId        String
  order          CosmeticOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cosmeticItemId String
  cosmeticItem   CosmeticItem        @relation(fields: [cosmeticItemId], references: [id])
  // FURNITURE only supports >1 (a `/nexo give` amount) — HAT/BACKPACK/
  // BALLOON grant a boolean permission, so quantity is always 1 there (the
  // cart UI only offers a quantity stepper for furniture in the first
  // place, see components/shop/CosmeticsCatalog.tsx). Persisted (not just
  // read off the order at checkout time) so a retry sweep grants the same
  // amount, not just 1.
  quantity       Int                 @default(1)
  status         CosmeticGrantStatus @default(PENDING)
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())

  @@index([status])
}

// Admin-authored, database-backed wiki — not literal Nextra (its file-based
// .mdx model can't support in-app editing on Vercel's read-only production
// filesystem), just matching its sidebar-of-categories look. See
// docs/superpowers/specs/2026-09-17-wiki-design.md.
model WikiCategory {
  id       String        @id @default(cuid())
  title    String
  slug     String        @unique
  order    Int           @default(0)
  articles WikiArticle[]
}

model WikiArticle {
  id         String @id @default(cuid())
  title      String
  slug       String @unique
  // Markdown source, may include the toolbar's alignment wrapper
  // (<div style="text-align:...">) — see lib/wiki-markdown.tsx for the
  // constrained rehype-sanitize schema that's the only raw HTML allowed
  // through on render.
  content    String
  categoryId String
  category   WikiCategory @relation(fields: [categoryId], references: [id])
  order      Int          @default(0)
  published  Boolean      @default(true)

  authorUserId String?
  author       User?   @relation(fields: [authorUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

// Player-suggested BlueMap markers (the "Запропонувати мітку" form on /map).
// Moderated in Discord (lib/map-markers-discord.ts); APPROVED ones are merged
// into BlueMap's live markers.json by the /live-map proxy — nothing is
// written to the Minecraft server's own BlueMap config.
enum MapMarkerType {
  CITY
  FARM
  EVENT
  MONUMENT
}

enum MapMarkerStatus {
  PENDING
  APPROVED
  REJECTED
}

model MapMarker {
  id String @id @default(cuid())

  label       String
  type        MapMarkerType
  description String?
  // Only meaningful for CITY — a validated discord.gg / discord.com/invite link.
  discordInvite String?

  // Optional look overrides (null = the type's default): a #rrggbb pin/
  // accent color, and an emoji from MARKER_ICONS in lib/map-markers.ts.
  color String?
  icon  String?
  // A player's own logo instead of an emoji: an uploaded or linked image,
  // validated (real PNG/JPEG/GIF/WebP bytes, size-capped) and stored as a
  // data: URI so it can be embedded inside the map pin's SVG. Served to
  // Discord via /api/map-marker-icon/<id>.
  iconImage String?

  x Int
  y Int
  z Int

  status MapMarkerStatus @default(PENDING)

  // Temporary markers: null = permanent. expiresAt is set from durationDays
  // at approval (not submission), so review time doesn't eat into it; the
  // /live-map proxy stops showing the marker once it has passed.
  durationDays Int?
  expiresAt    DateTime?

  submittedByUserId String
  submittedByUser   User   @relation(fields: [submittedByUserId], references: [id])
  nickname          String // linked Minecraft nickname at submission time

  // The moderation message in the map channel — edited in place on clicks.
  discordMessageId String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([status])
  @@index([submittedByUserId, createdAt])
}

// Discord members already sent the welcome DM (bot/index.mjs) — one row
// per member, written even when the DM fails (closed DMs), so nobody is
// messaged twice.
model WelcomeDm {
  discordUserId String   @id
  delivered     Boolean
  sentAt        DateTime @default(now())
}

// Site-wide switches set from /admin. Single row (id "default").
model SiteSettings {
  id String @id @default("default")
  // Keys from SITE_PAGES in lib/site-pages.ts — hidden from the nav and
  // 404 for everyone except admins.
  disabledPages String[] @default([])
  // Minecraft server address shown on /join, copied by its button and sent
  // in the Discord welcome DM.
  serverIp String @default("mc.kvitkovyi.pp.ua")
  // Game version shown next to it ("з версії …" / "на версії …").
  serverVersion String @default("26.2")
  // Discord ids granted site admin from the Discord admin panel
  // (lib/site-admins.ts) before they ever signed in to the site — promoted
  // on their first login (lib/auth.ts linkAccount), then removed from here.
  pendingAdminDiscordIds String[] @default([])
}
